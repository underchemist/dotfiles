# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
source $ZSH/custom/plugins/zsh-defer/zsh-defer.plugin.zsh

ZSH_THEME="robbyrussell"

zsh-defer source $ZSH/plugins/nvm/nvm.plugin.zsh
zsh-defer source $ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
zsh-defer source $ZSH/plugins/fzf/fzf.plugin.zsh
zsh-defer source $ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh

plugins=(git aws direnv zsh-kubectl-prompt zoxide)

source $ZSH/oh-my-zsh.sh

# Aliases
alias k="kubectl"
alias cz="chezmoi"
alias aptuua="sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y"
alias today="date +'%Y-%m-%d'"

# Path
export PATH="$PATH:$HOME/.local/bin"
# krew
export PATH="$PATH:$HOME/.krew/bin"

# kubectl prompt
{{ if stat (joinPath .chezmoi.homeDir ".kube/config") -}}
if [[ "$RPROMPT" != *'$ZSH_KUBECTL_PROMPT'* ]] ; then
    RPROMPT="$RPROMPT "'%{$fg[blue]%}($ZSH_KUBECTL_PROMPT)%{$reset_color%}'
fi
{{ end -}}
{{ if stat (joinPath .chezmoi.homeDir ".local/bin/nvim-linux-x86_64") -}}
export PATH="$PATH:$HOME/.local/bin/nvim-linux-x86_64/bin"
{{ end -}}
{{ if stat (joinPath .chezmoi.homeDir ".pixi") -}}
export PATH="$PATH:$HOME/.pixi/bin"
{{ end -}}
{{ if stat (joinPath .chezmoi.homeDir ".cargo") -}}
source $HOME/.cargo/env
{{ end -}}

# Functions
function scratch() {
    SCRATCH_DIR=$(mktemp -d)
    cd $SCRATCH_DIR
}

function source_gdal_env() {
    if [[ -n "$_LD_LIBRARY_PATH" ]]; then
        echo "source_gdal_env already called"
        exit 1
    fi

    if [[ -n "$_PATH" ]]; then
        exit 1
    fi

    if [[ -z "$LD_LIBRARY_PATH" ]]; then
        export LD_LIBRARY_PATH="$HOME/opt/gdal/lib:$HOME/opt/pdal/lib"
    fi

    export _PATH=$PATH
    export PATH="$HOME/opt/gdal/bin:$HOME/opt/pdal/bin:$PATH"
}

function deactivate_gdal_env() {
    export PATH=$_PATH
    unset LD_LIBRARY_PATH
    unset _PATH
}
